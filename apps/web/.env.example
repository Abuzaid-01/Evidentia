# Copy to apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# dev   = pick a local persona (API must run with AUTH_MODE=dev, ENVIRONMENT=local)
# clerk = real sign-in with organisations (API must run with AUTH_MODE=clerk)
NEXT_PUBLIC_AUTH_MODE=dev

# Clerk dashboard > API Keys (only when NEXT_PUBLIC_AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
