# ---------------------------------------------------------------------------
# Evidentia configuration. Copy to `.env` (never commit `.env`).
# The API and workers read this file; the web app reads apps/web/.env.local.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- infrastructure (created by `make setup`) --------------------------------
DATABASE_URL=postgresql+psycopg://evidentia:evidentia@localhost:5434/evidentia
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
# Public HTTPS URL of the API so Cloudinary can send webhooks.
# Local: run `make tunnel` and paste the https://....trycloudflare.com URL here.
PUBLIC_API_BASE_URL=

# --- auth ----------------------------------------------------------------------
# dev   = no external login (local only). Pick a dev identity in the web app.
# clerk = real login. Needs CLERK_ISSUER (Clerk dashboard > API Keys > Frontend API URL).
AUTH_MODE=dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Cloudinary (Console > Settings > API Keys) ------------------------------------
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER_ROOT=evidentia
CLOUDINARY_SIGNATURE_ALGORITHM=sha1
# Created by `make cloudinary-bootstrap` (leave empty to upload without a preset)
CLOUDINARY_UPLOAD_PRESET_IMAGE=evidentia_image
CLOUDINARY_UPLOAD_PRESET_VIDEO=evidentia_video
CLOUDINARY_USE_NAMED_TRANSFORMATIONS=true
# true only after bootstrap created the structured metadata fields
CLOUDINARY_USE_STRUCTURED_METADATA=false
# Analyze API (Beta): captioning, image_quality, ai_vision_tagging, ai_vision_general
CLOUDINARY_ANALYZE_ENABLED=true
# OCR add-on (Console > Add-ons > OCR Text Detection and Extraction)
CLOUDINARY_OCR_ENABLED=false
# Auto-tagging add-on, e.g. google_tagging | imagga_tagging | aws_rek_tagging (empty = off)
CLOUDINARY_AUTO_TAGGING=
CLOUDINARY_WRITEBACK_ENABLED=true

# --- AI vision providers (tried in order; unconfigured ones are skipped) -------------
# Options: cloudinary, gemini, groq, mock  (mock = fake output for offline dev only)
AI_VISION_PROVIDERS=cloudinary,gemini,groq
# Google AI Studio > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# console.groq.com > API Keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Text LLM for search planning + claim validation (tried in order; unconfigured are skipped)
LLM_TEXT_PROVIDERS=gemini,groq
GEMINI_TEXT_MODEL=gemini-2.5-flash
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# --- search (Phase 3) ---------------------------------------------------------------------
# SigLIP embeddings (downloaded once, ~800 MB). Set EMBEDDINGS_ENABLED=false on tiny machines:
# search then uses full-text + activities + Cloudinary Search only.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=google/siglip-base-patch16-224
EMBEDDING_DEVICE=cpu
# Load the model when the API starts (first search is otherwise ~10 s slower)
EMBEDDINGS_WARMUP=false
SEARCH_CLOUDINARY_ENABLED=true
SEARCH_LLM_PLANNER_ENABLED=true

# --- demo mode (one-click presentation flow; all calls are real) ---------------------
DEMO_MODE_ENABLED=true

# --- media policy ----------------------------------------------------------------------
MAX_IMAGE_BYTES=41943040
MAX_VIDEO_BYTES=524288000
MAX_VIDEO_SECONDS=600
